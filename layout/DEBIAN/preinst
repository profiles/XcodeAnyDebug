#!/bin/bash

set -e

if [ -f /usr/bin/debugserver_xcode ]; then
    rm -rf /usr/bin/debugserver_xcode
fi

if [ -f /usr/libexec/debugserver ]; then
    # ios 16.x+
    cp /usr/libexec/debugserver /usr/bin/debugserver_xcode

elif [ -d /Developer ] && [ "$(ls -A /Developer)" ]; then
    if [ -f /Developer/usr/bin/debugserver ]; then
        cp /Developer/usr/bin/debugserver /usr/bin/debugserver_xcode
    else
        echo "* debugserver for xcode not found on your device" >&2
        exit 1
    fi
else
    echo "* Developer Disk Image not mounted, run xcode to connect and pair your device first." >&2
    exit 1
fi
